namespace TruthGate

open MvPolynomial

-- TRUTH-GATE LOCK BEGIN
/-- The repository's statements: `jacobianDeg12_finrank_eq`, `stdTriples12_card`,
`stdMonomial_linearIndependent`, `jacobianDeg12_eq_span`. -/
def formal_claim : Prop :=
  Module.finrank ℚ Hodge.ChainSexticRank.jacobianDeg12 = 1751 ∧
    Hodge.ChainSexticRank.stdTriples12.card = 1751 ∧
    LinearIndependent ℚ
      (fun t : Hodge.ChainSexticRank.stdTriples12 => Hodge.ChainSexticRank.stdMonomial t.1) ∧
    Hodge.ChainSexticRank.jacobianDeg12 = Submodule.span ℚ
      (Set.range fun t : Hodge.ChainSexticRank.stdTriples12 =>
        Hodge.ChainSexticRank.stdMonomial t.1)

/-- Paper: the pair coordinate `x_k` (`k = 0, 1, 2`). -/
def pX (k : Fin 3) : Fin 6 := ⟨k.val, by omega⟩

/-- Paper: the pair coordinate `y_k = x_{k+3}`. -/
def pY (k : Fin 3) : Fin 6 := ⟨k.val + 3, by omega⟩

/-- Paper: `F = f(x₀,y₀) + f(x₁,y₁) + f(x₂,y₂)` with `f(x,y) = x⁵y + y⁶`. -/
noncomputable def pF : MvPolynomial (Fin 6) ℚ :=
  ∑ k : Fin 3, (X (pX k) ^ 5 * X (pY k) + X (pY k) ^ 6)

/-- Paper: `J`, the ideal generated by the six partial derivatives of `F`. -/
noncomputable def pJ : Ideal (MvPolynomial (Fin 6) ℚ) :=
  Ideal.span (Set.range fun i : Fin 6 => pderiv i pF)

/-- Paper: `R₁₂`, the image of the degree-12 homogeneous polynomials in `R = ℚ[x]/J`. -/
noncomputable def pR12 : Submodule ℚ (MvPolynomial (Fin 6) ℚ ⧸ pJ) :=
  (homogeneousSubmodule (Fin 6) ℚ 12).map (Ideal.Quotient.mkₐ ℚ pJ).toLinearMap

/-- Paper: a pair monomial `x^a y^b` is standard if `a ≤ 4`, `b ≤ 5`, and not (`a = 4` and `b ≥ 1`). -/
def pStdPair (a b : ℕ) : Prop := a ≤ 4 ∧ b ≤ 5 ∧ ¬ (a = 4 ∧ 1 ≤ b)

/-- Paper: exponent vectors of the standard monomials of total degree 12 (one standard pair
monomial per pair). -/
def pStd12 : Set (Fin 6 →₀ ℕ) :=
  {d | (∀ k : Fin 3, pStdPair (d (pX k)) (d (pY k))) ∧ ∑ i, d i = 12}

/-- Paper Theorem thm:r12: `dim_ℚ R₁₂ = 1751`, and the classes of the 1751 standard monomials of
degree 12 form a basis of `R₁₂`. -/
def paper_claim : Prop :=
  Module.finrank ℚ pR12 = 1751 ∧
    pStd12.ncard = 1751 ∧
    LinearIndependent ℚ (fun d : pStd12 => Ideal.Quotient.mk pJ (monomial (d : Fin 6 →₀ ℕ) (1 : ℚ))) ∧
    Submodule.span ℚ (Set.range fun d : pStd12 =>
      Ideal.Quotient.mk pJ (monomial (d : Fin 6 →₀ ℕ) (1 : ℚ))) = pR12

theorem pF_eq : pF = Hodge.ChainSexticRank.chainSextic := by
  have x0 : pX 0 = 0 := rfl
  have x1 : pX 1 = 1 := rfl
  have x2 : pX 2 = 2 := rfl
  have y0 : pY 0 = 3 := rfl
  have y1 : pY 1 = 4 := rfl
  have y2 : pY 2 = 5 := rfl
  simp only [pF, Fin.sum_univ_three, x0, x1, x2, y0, y1, y2, Hodge.ChainSexticRank.chainSextic]
  ring

theorem pJ_eq : pJ = Hodge.ChainSexticRank.jacobianIdeal := by
  rw [pJ, pF_eq]
  rfl

/-- The paper's standard degree-12 exponent vectors are exactly the `dt`-images of the
repository's `stdTriples12`. -/
theorem pStd12_eq_range :
    pStd12 = Set.range fun t : Hodge.ChainSexticRank.stdTriples12 => Hodge.ChainSexticR12.dt t.1 := by
  ext d
  constructor
  · rintro ⟨hp, hs⟩
    have h0 := hp 0
    have h1 := hp 1
    have h2 := hp 2
    simp only [pStdPair] at h0 h1 h2
    have e0 : pX 0 = 0 := rfl
    have e1 : pX 1 = 1 := rfl
    have e2 : pX 2 = 2 := rfl
    have f0 : pY 0 = 3 := rfl
    have f1 : pY 1 = 4 := rfl
    have f2 : pY 2 = 5 := rfl
    rw [e0, f0] at h0
    rw [e1, f1] at h1
    rw [e2, f2] at h2
    rw [Fin.sum_univ_six] at hs
    refine ⟨⟨((d 0, d 3), (d 1, d 4), (d 2, d 5)), ?_⟩, ?_⟩
    · simp only [Hodge.ChainSexticRank.stdTriples12, Hodge.ChainSexticRank.stdPairs,
        Finset.mem_filter, Finset.mem_product, Finset.mem_range]
      omega
    · ext i
      fin_cases i <;> simp [Hodge.ChainSexticR12.dt]
  · rintro ⟨⟨t, ht⟩, rfl⟩
    simp only [Hodge.ChainSexticRank.stdTriples12, Hodge.ChainSexticRank.stdPairs,
      Finset.mem_filter, Finset.mem_product, Finset.mem_range] at ht
    obtain ⟨a0, a3, a1, a4, a2, a5⟩ := Hodge.ChainSexticR12.dt_apply t
    refine ⟨fun k => ?_, ?_⟩
    · fin_cases k
      · show pStdPair (Hodge.ChainSexticR12.dt t 0) (Hodge.ChainSexticR12.dt t 3)
        rw [a0, a3]; simp only [pStdPair]; omega
      · show pStdPair (Hodge.ChainSexticR12.dt t 1) (Hodge.ChainSexticR12.dt t 4)
        rw [a1, a4]; simp only [pStdPair]; omega
      · show pStdPair (Hodge.ChainSexticR12.dt t 2) (Hodge.ChainSexticR12.dt t 5)
        rw [a2, a5]; simp only [pStdPair]; omega
    · rw [Fin.sum_univ_six, a0, a1, a2, a3, a4, a5]
      omega

/-- The bijection between the repository's triples and the paper's exponent vectors. -/
noncomputable def tripleEquiv : Hodge.ChainSexticRank.stdTriples12 ≃ pStd12 :=
  (Equiv.ofInjective (fun t : Hodge.ChainSexticRank.stdTriples12 => Hodge.ChainSexticR12.dt t.1)
    (fun _ _ h => Subtype.ext (Hodge.ChainSexticR12.dt_injective h))).trans
    (Equiv.setCongr pStd12_eq_range.symm)

theorem tripleEquiv_apply (t : Hodge.ChainSexticRank.stdTriples12) :
    ((tripleEquiv t : pStd12) : Fin 6 →₀ ℕ) = Hodge.ChainSexticR12.dt t.1 := rfl

/-- Transport across `I = jacobianIdeal` (the paper's `J` is the repository's ideal). -/
theorem transport (I : Ideal (MvPolynomial (Fin 6) ℚ))
    (h : I = Hodge.ChainSexticRank.jacobianIdeal) :
    (Module.finrank ℚ Hodge.ChainSexticRank.jacobianDeg12 = 1751 ∧
      Hodge.ChainSexticRank.stdTriples12.card = 1751 ∧
      LinearIndependent ℚ
        (fun t : Hodge.ChainSexticRank.stdTriples12 => Hodge.ChainSexticRank.stdMonomial t.1) ∧
      Hodge.ChainSexticRank.jacobianDeg12 = Submodule.span ℚ
        (Set.range fun t : Hodge.ChainSexticRank.stdTriples12 =>
          Hodge.ChainSexticRank.stdMonomial t.1)) ↔
    (Module.finrank ℚ ((homogeneousSubmodule (Fin 6) ℚ 12).map
        (Ideal.Quotient.mkₐ ℚ I).toLinearMap) = 1751 ∧
      pStd12.ncard = 1751 ∧
      LinearIndependent ℚ (fun d : pStd12 => Ideal.Quotient.mk I (monomial (d : Fin 6 →₀ ℕ) (1 : ℚ))) ∧
      Submodule.span ℚ (Set.range fun d : pStd12 =>
        Ideal.Quotient.mk I (monomial (d : Fin 6 →₀ ℕ) (1 : ℚ))) =
        (homogeneousSubmodule (Fin 6) ℚ 12).map (Ideal.Quotient.mkₐ ℚ I).toLinearMap) := by
  subst h
  have hfun : (fun t : Hodge.ChainSexticRank.stdTriples12 => Hodge.ChainSexticRank.stdMonomial t.1) =
      (fun d : pStd12 => Ideal.Quotient.mk Hodge.ChainSexticRank.jacobianIdeal
        (monomial (d : Fin 6 →₀ ℕ) (1 : ℚ))) ∘ tripleEquiv := by
    funext t
    simp only [Function.comp_apply, tripleEquiv_apply]
    exact Hodge.ChainSexticR12.stdMonomial_eq t.1
  have hcard : pStd12.ncard = Hodge.ChainSexticRank.stdTriples12.card := by
    rw [← Nat.card_coe_set_eq, Nat.card_congr tripleEquiv.symm, Nat.card_eq_fintype_card,
      Fintype.card_coe]
  have hrange : (Set.range fun t : Hodge.ChainSexticRank.stdTriples12 =>
        Hodge.ChainSexticRank.stdMonomial t.1) =
      Set.range (fun d : pStd12 => Ideal.Quotient.mk Hodge.ChainSexticRank.jacobianIdeal
        (monomial (d : Fin 6 →₀ ℕ) (1 : ℚ))) := by
    rw [hfun, Set.range_comp, tripleEquiv.range_eq_univ, Set.image_univ]
  rw [hcard, hfun, linearIndependent_equiv, ← hfun, hrange]
  constructor
  · rintro ⟨a, b, c, d⟩; exact ⟨a, b, c, d.symm⟩
  · rintro ⟨a, b, c, d⟩; exact ⟨a, b, c, d.symm⟩

/-- The fixed correspondence between the formal statement and the paper's claim. -/
theorem intended_correspondence : formal_claim ↔ paper_claim := by
  unfold formal_claim paper_claim pR12
  exact transport pJ pJ_eq
-- TRUTH-GATE LOCK END

/-- The repository's theorems prove `formal_claim`. -/
theorem formal_claim_holds : formal_claim :=
  ⟨Hodge.ChainSexticR12.jacobianDeg12_finrank_eq, Hodge.ChainSexticRank.stdTriples12_card,
    Hodge.ChainSexticR12.stdMonomial_linearIndependent, Hodge.ChainSexticR12.jacobianDeg12_eq_span⟩

/-- The paper's claim, transported across the correspondence. -/
theorem paper_claim_holds : paper_claim :=
  intended_correspondence.mp formal_claim_holds

/-- Non-vacuity witness: `x₀⁴ x₁⁴ x₂⁴` is a paper standard monomial of degree 12, and its class in
`R = ℚ[x]/J` is nonzero (it is a member of the independent family). -/
theorem nonvacuity_witness :
    ∃ d ∈ pStd12, Ideal.Quotient.mk pJ (monomial d (1 : ℚ)) ≠ 0 := by
  have hmem : (Finsupp.single 0 4 + Finsupp.single 1 4 + Finsupp.single 2 4 : Fin 6 →₀ ℕ) ∈ pStd12 := by
    refine ⟨fun k => ?_, ?_⟩
    · fin_cases k <;> simp [pStdPair, pX, pY]
    · simp [Fin.sum_univ_six, Finsupp.single_apply]
  refine ⟨_, hmem, fun h0 => ?_⟩
  have li := (intended_correspondence.mp formal_claim_holds).2.2.1
  exact li.ne_zero ⟨_, hmem⟩ h0

end TruthGate
