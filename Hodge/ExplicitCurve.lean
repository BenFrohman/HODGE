Explicit non-monomial surfaces on X = V(Σ x_i^5 x_{i+3} + x_{i+3}^6) ⊂ P^5 (v1.3).

Containment only (ring identities). The cohomological claim (nonzero projection on the
cited D24 characters) is proved classically using an exact residue certificate in
  docs/EXPLICIT_PROJECTION_CERTIFICATE.md, not formalized here.
-/
import Mathlib

set_option linter.unusedSimpArgs false

namespace Hodge.ExplicitCurve

/-- H(X,Y) = X^2 + bXY + cY^2 and G = X^3 + dX^2Y + eXY^2 + gY^3. -/
def H {R : Type*} [CommRing R] (b c X Y : R) : R := X^2 + b*X*Y + c*Y^2
def G {R : Type*} [CommRing R] (d e g X Y : R) : R := X^3 + d*X^2*Y + e*X*Y^2 + g*Y^3

/-- Section identity: if (b,c,d,e,g) satisfy the six coefficient relations then G^2 - H^3 = kX^5Y + Y^6. -/
theorem section_identity {R : Type*} [CommRing R] (k b c d e g X Y : R)
  (h5 : 2*d - 3*b - k = 0) (h4 : d^2 + 2*e - 3*c - 3*b^2 = 0)
  (h3 : 2*g + 2*d*e - b^3 - 6*b*c = 0) (h2 : e^2 + 2*d*g - 3*c^2 - 3*b^2*c = 0)
  (h1 : 2*e*g - 3*b*c^2 = 0) (h0 : g^2 - c^3 - 1 = 0) :
  G d e g X Y ^ 2 - H b c X Y ^ 3 = k*X^5*Y + Y^6 := by
  unfold G H
  linear_combination (X^5*Y)*h5 + (X^4*Y^2)*h4 + (X^3*Y^3)*h3 + (X^2*Y^4)*h2 + (X*Y^5)*h1 + Y^6*h0

/-- The cone surface S = {x3 = 0, H(X2,x5) = μ^2 H(X1,x4), G(X2,x5) = μ^3 G(X1,x4)} (x1 = ρX1, x2 = ρX2, ρ^5 = k, μ^6 = -1) lies on X. -/
theorem cone_on_X {R : Type*} [CommRing R] (k b c d e g ρ μ x0 X1 X2 x4 x5 : R)
  (h5 : 2*d - 3*b - k = 0) (h4 : d^2 + 2*e - 3*c - 3*b^2 = 0)
  (h3 : 2*g + 2*d*e - b^3 - 6*b*c = 0) (h2 : e^2 + 2*d*g - 3*c^2 - 3*b^2*c = 0)
  (h1 : 2*e*g - 3*b*c^2 = 0) (h0 : g^2 - c^3 - 1 = 0)
  (hρ : ρ^5 = k) (hμ : μ^6 = -1)
  (hQ : H b c X2 x5 = μ^2 * H b c X1 x4) (hK : G d e g X2 x5 = μ^3 * G d e g X1 x4) :
  let x : Fin 6 → R := ![x0, ρ*X1, ρ*X2, 0, x4, x5]
  x 3 * (x 0^5 + x 3^5) + x 4 * (x 1^5 + x 4^5) + x 5 * (x 2^5 + x 5^5) = 0 := by
  intro x
  have s1 := section_identity k b c d e g X1 x4 h5 h4 h3 h2 h1 h0
  have s2 := section_identity k b c d e g X2 x5 h5 h4 h3 h2 h1 h0
  simp only [x, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val]
  linear_combination (X1^5*x4 + X2^5*x5)*hρ - s1 - s2 + (G d e g X2 x5 + μ^3 * G d e g X1 x4)*hK - (H b c X2 x5^2 + μ^2*H b c X1 x4*H b c X2 x5 + μ^4*H b c X1 x4^2)*hQ + (G d e g X1 x4^2 - H b c X1 x4^3)*hμ

/-- The minimal polynomial m(k) (degree 24, irreducible over ℚ). -/
def m (k : ℚ) : ℚ := k^24 + 66081312000*k^18 - 4811512860000*k^12 + 1167566400000*k^6 + 583200000

def sb {K : Type*} [Field K] [Algebra ℚ K] (k : K) : K := algebraMap ℚ K 0 + ((-722487197/183091906523168640000:K)*k^19 + (-159143006270106241/610306355077228800:K)*k^13 + (21430060790263809/1130196953846720:K)*k^7 + (-174160669504533/56509847692336:K)*k^1)
def sc {K : Type*} [Field K] [Algebra ℚ K] (k : K) : K := algebraMap ℚ K 0 + ((24042395351/2197102878278023680000:K)*k^20 + (8826405713420672683/12206127101544576000:K)*k^14 + (-2143524127385205629/40687090338481920:K)*k^8 + (3380935656389167/226039390769344:K)*k^2)
def sd {K : Type*} [Field K] [Algebra ℚ K] (k : K) : K := algebraMap ℚ K 0 + ((-722487197/122061271015445760000:K)*k^19 + (-159143006270106241/406870903384819200:K)*k^13 + (64290182370791427/2260393907693440:K)*k^7 + (-465972160821263/113019695384672:K)*k^1)
def se {K : Type*} [Field K] [Algebra ℚ K] (k : K) : K := algebraMap ℚ K 0 + ((15878253037/732367626092674560000:K)*k^20 + (5829198849736071413/4068709033848192000:K)*k^14 + (-1415338276429814887/13562363446160640:K)*k^8 + (6374456883163051/226039390769344:K)*k^2)
def sg {K : Type*} [Field K] [Algebra ℚ K] (k : K) : K := algebraMap ℚ K 0 + ((-513327/14822255132416000:K)*k^21 + (-228968921103986341/100050222143808000:K)*k^15 + (92593187871722149/555834567465600:K)*k^9 + (-68117921986169/1852781891552:K)*k^3)

/-- The exhibited algebraic numbers satisfy the six relations, for any root k of m in any field of char 0. -/
theorem rel_h5 {K : Type*} [Field K] [CharZero K] [Algebra ℚ K] (k : K)
  (hm : k^24 + 66081312000*k^18 - 4811512860000*k^12 + 1167566400000*k^6 + 583200000 = 0) :
  2*sd k - 3*sb k - k = 0 := by
  simp only [sb, sc, sd, se, sg, map_zero, zero_add]
  linear_combination ((0:K)*k^0)*hm

theorem rel_h4 {K : Type*} [Field K] [CharZero K] [Algebra ℚ K] (k : K)
  (hm : k^24 + 66081312000*k^18 - 4811512860000*k^12 + 1167566400000*k^6 + 583200000 = 0) :
  sd k^2 + 2*se k - 3*sc k - 3*sb k^2 = 0 := by
