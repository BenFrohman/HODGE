import Mathlib

/-!
# The rank bounds `2 ≤ ρ_Hdg(V(F)) ≤ 1752` for the chain sextic

    F = x0^5 x3 + x3^6 + x1^5 x4 + x4^6 + x2^5 x5 + x5^6,   X = V(F) ⊂ P^5.

The quantity `Z` recorded in `Hodge.ContainerSeparation.Z_bounds` and
`Hodge.HostSplit.Z_bounds` (commit b27f1a0) is the rank of the rational Hodge lattice

    ρ_Hdg(X) = dim_ℚ Hdg²(X, ℚ),   Hdg²(X, ℚ) = H⁴(X, ℚ) ∩ H^{2,2}(X).

The two placeholders there are the numeral fact `2 ≤ 1752` and a string label.
This file replaces them by real mathematics, split into three honest layers.

## Layer 1: unconditional, about the actual polynomial `F` (no hypotheses)

* `chainSextic` is `F` as an element of `ℚ[x0,…,x5]`; `chainSextic_isHomogeneous` (degree 6).
* `jacobianIdeal` is the ideal generated by the six `MvPolynomial.pderiv` partials of `F`;
  `pderiv_chainSextic_low/high` compute them.
* `jacobianDeg12` is the degree-12 graded piece `R₁₂` of the Jacobian ring
  `ℚ[x]/J_F` (image of the homogeneous degree-12 polynomials).
* `jacobianDeg12_finrank_le : finrank ℚ jacobianDeg12 ≤ 1751` is a full proof:
  every degree-12 monomial is reduced, using only the relations `x⁴y = 0`, `x⁵ = -6y⁵`,
  `y⁶ = 0` in each pair (consequences of the partials), to the 1751 standard monomials
  counted by `stdTriples12_card` (kernel `decide`). This is the division-algorithm half
  of the Gröbner argument and needs no cited theorem. The reverse inequality
  (`= 1751`, independence of the standard monomials) is not proved here and is not needed.
* `planeSelfIntersection_eq : planeSelfIntersection = 21`: the degree-2 coefficient of
  `(1+h)³ · (1 - 6h + 36h²)`, i.e. `c₂` of `(1+h)³/(1+6h)` mod `h³`
  (`one_add_six_mul_inverse` checks the inverse). `gram_det_eq : 6 * 21 - 1 * 1 = 125`.

## Layer 2: unconditional linear algebra (mathlib only)

* `rationalPoints W` for a complex subspace `W ⊆ ℂ ⊗[ℚ] H` is `{v ∈ H | 1 ⊗ v ∈ W}`.
* `finrank_rationalPoints_le : finrank ℚ (rationalPoints W) ≤ finrank ℂ W`
  (flat base change `ℚ → ℂ` is injective).
* `two_le_finrank_of_gram`: two vectors with nonzero `2×2` Gram determinant span a
  subspace of rank at least 2.

## Layer 3: the geometric bridge, as explicit hypotheses (NOT proved here)

`ChainSexticHodgeBridge H` bundles exactly the classical inputs that mathlib cannot yet state
for a smooth projective fourfold:
* `H` is `H⁴(X, ℚ)` (finite dimensional) and `H22 ⊆ ℂ ⊗ H` is `H^{2,2}(X)`;
* `griffiths : finrank ℂ H22 = 1 + finrank ℚ jacobianDeg12`
  (Griffiths residue isomorphism `H^{2,2}_prim ≅ R₁₂` for smooth `X`, plus the
  Lefschetz class; smoothness of `X` is `SpecialSextic.gradient_only_origin`);
* `pairing` is the cup-product form and `h2`, `P` are the classes of `h²` and of the plane
  `Π = {x3 = x4 = x5 = 0}` (which lies on `X` by `SpecialSextic.F_mem_plane`), both Hodge
  classes, with intersection numbers `h²·h² = 6 = deg F`, `h²·Π = 1`,
  `Π·Π = c₂(N_{Π/X}) = planeSelfIntersection`.

`rho_bounds (D : ChainSexticHodgeBridge H) : 2 ≤ D.rho ∧ D.rho ≤ 1752` is then a full proof.
It is a theorem *conditional on the bridge hypotheses*, not an unconditional statement about
the cohomology of `X`: cohomology, Hodge decomposition, cycle classes, the Griffiths residue
map and the self-intersection formula are not formalized. No `sorry`, no new axioms,
no `native_decide`.

The upper bound 1752 is a complex dimension (`h^{2,2}`); the lower bound 2 comes from the
independent algebraic classes `h²`, `[Π]` (Gram determinant 125). Neither is the exact rank;
the Python count in `STATUS.md` (786) is not formalized here.
-/

open Module TensorProduct MvPolynomial

namespace Hodge
namespace ChainSexticRank

/-! ## Layer 2: linear algebra -/

section LinearAlgebra
variable {H : Type*} [AddCommGroup H] [Module ℚ H]

/-- The rational points `{v ∈ H | 1 ⊗ v ∈ W}` of a complex subspace `W ⊆ ℂ ⊗[ℚ] H`.
For `H = H⁴(X,ℚ)` and `W = H^{2,2}(X)` this is `Hdg²(X,ℚ)`. -/
noncomputable def rationalPoints (W : Submodule ℂ (ℂ ⊗[ℚ] H)) : Submodule ℚ H :=
  (W.restrictScalars ℚ).comap (TensorProduct.mk ℚ ℂ H 1)

theorem mem_rationalPoints (W : Submodule ℂ (ℂ ⊗[ℚ] H)) (v : H) :
    v ∈ rationalPoints W ↔ (1 : ℂ) ⊗ₜ[ℚ] v ∈ W := Iff.rfl

/-- A rational subspace whose complexification lies in `W` has `ℚ`-rank at most `dim_ℂ W`. -/
theorem finrank_rationalPoints_le [FiniteDimensional ℚ H] (W : Submodule ℂ (ℂ ⊗[ℚ] H)) :
    finrank ℚ (rationalPoints W) ≤ finrank ℂ W := by
  set V := rationalPoints W
  let f : ℂ ⊗[ℚ] V →ₗ[ℂ] ℂ ⊗[ℚ] H := V.subtype.baseChange ℂ
  have hf : Function.Injective f := by
    have := Module.Flat.lTensor_preserves_injective_linearMap (M := ℂ) V.subtype
      Subtype.val_injective
    rw [show (f : ℂ ⊗[ℚ] V → ℂ ⊗[ℚ] H) = V.subtype.lTensor ℂ from
      LinearMap.baseChange_eq_ltensor _]
    exact this
  have hrange : LinearMap.range f ≤ W := by
    rintro _ ⟨t, rfl⟩
    induction t using TensorProduct.induction_on with
    | zero => simp
    | tmul c v =>
      have hv : (1 : ℂ) ⊗ₜ[ℚ] (v : H) ∈ W := v.2
      have : f (c ⊗ₜ v) = c • ((1 : ℂ) ⊗ₜ[ℚ] (v : H)) := by
        simp [f, LinearMap.baseChange_tmul, TensorProduct.smul_tmul']
      rw [this]; exact W.smul_mem c hv
    | add a b ha hb => rw [map_add]; exact W.add_mem ha hb
  calc finrank ℚ V = finrank ℂ (ℂ ⊗[ℚ] V) := (Module.finrank_baseChange).symm
    _ = finrank ℂ (LinearMap.range f) := (LinearMap.finrank_range_of_inj hf).symm
    _ ≤ finrank ℂ W := Submodule.finrank_mono hrange

/-- Two vectors of `S` with nonzero Gram determinant are independent, so `2 ≤ finrank S`. -/
theorem two_le_finrank_of_gram {S : Submodule ℚ H} [FiniteDimensional ℚ S]
    (B : LinearMap.BilinForm ℚ H) (v w : H) (hv : v ∈ S) (hw : w ∈ S)
    (hdet : B v v * B w w - B v w * B w v ≠ 0) : 2 ≤ finrank ℚ S := by
  have hli : LinearIndependent ℚ ![(⟨v, hv⟩ : S), ⟨w, hw⟩] := by
    rw [LinearIndependent.pair_iff]
    intro a b hab
    have hab' : a • v + b • w = 0 := by
      have := congrArg Subtype.val hab
      simpa using this
    have e1 : a * B v v + b * B w v = 0 := by
      have := congrArg (fun z => B z v) hab'
      simpa using this
    have e2 : a * B v w + b * B w w = 0 := by
      have := congrArg (fun z => B z w) hab'
      simpa using this
    have ha : a * (B v v * B w w - B v w * B w v) = 0 := by linear_combination (B w w) * e1 - (B w v) * e2
    have hb : b * (B v v * B w w - B v w * B w v) = 0 := by linear_combination (B v v) * e2 - (B v w) * e1
    exact ⟨(mul_eq_zero.mp ha).resolve_right hdet, (mul_eq_zero.mp hb).resolve_right hdet⟩
  simpa using hli.fintype_card_le_finrank

end LinearAlgebra

/-! ## Layer 1: the actual chain sextic and its Jacobian ring -/

/-- The chain sextic `F` as an honest polynomial in `ℚ[x0,…,x5]`. -/
noncomputable def chainSextic : MvPolynomial (Fin 6) ℚ :=
  X 0 ^ 5 * X 3 + X 3 ^ 6 + X 1 ^ 5 * X 4 + X 4 ^ 6 + X 2 ^ 5 * X 5 + X 5 ^ 6

theorem chainSextic_isHomogeneous : chainSextic.IsHomogeneous 6 := by
  unfold chainSextic
  have hX : ∀ i : Fin 6, (X i : MvPolynomial (Fin 6) ℚ).IsHomogeneous 1 := fun i => isHomogeneous_X ℚ i
  refine IsHomogeneous.add (IsHomogeneous.add (IsHomogeneous.add (IsHomogeneous.add
    (IsHomogeneous.add ?_ ?_) ?_) ?_) ?_) ?_
  · exact ((hX 0).pow 5).mul (hX 3)
  · exact (hX 3).pow 6
  · exact ((hX 1).pow 5).mul (hX 4)
  · exact (hX 4).pow 6
  · exact ((hX 2).pow 5).mul (hX 5)
  · exact (hX 5).pow 6

/-- The Jacobian ideal: generated by the six honest partial derivatives. -/
noncomputable def jacobianIdeal : Ideal (MvPolynomial (Fin 6) ℚ) :=
  Ideal.span (Set.range fun i => pderiv i chainSextic)

theorem pderiv_chainSextic_low (i : Fin 3) :
    pderiv (Fin.castLE (by norm_num) i) chainSextic =
      5 * X (Fin.castLE (by norm_num) i) ^ 4 * X (Fin.natAdd 3 i) := by
  fin_cases i <;> (simp [chainSextic, pderiv_X]; try ring)

theorem pderiv_chainSextic_high (i : Fin 3) :
    pderiv (Fin.natAdd 3 i) chainSextic =
      X (Fin.castLE (by norm_num) i) ^ 5 + 6 * X (Fin.natAdd 3 i) ^ 5 := by
  fin_cases i <;> (simp [chainSextic, pderiv_X]; try ring)

/-- standard monomials `x^a y^b` of one pair: not divisible by `x⁴y`, `x⁵`, `y⁶`. -/
def stdPairs : Finset (ℕ × ℕ) :=
  ((Finset.range 5) ×ˢ (Finset.range 6)).filter fun p => ¬(4 ≤ p.1 ∧ 1 ≤ p.2)

theorem stdPairs_card : stdPairs.card = 25 := by decide

/-- Exponent triples `((a0,b0),(a1,b1),(a2,b2))` of standard pair monomials with total
degree 12; the monomial is `x0^a0 x3^b0 · x1^a1 x4^b1 · x2^a2 x5^b2`. -/
def stdTriples12 : Finset ((ℕ × ℕ) × (ℕ × ℕ) × (ℕ × ℕ)) :=
  (stdPairs ×ˢ stdPairs ×ˢ stdPairs).filter fun t =>
    t.1.1 + t.1.2 + (t.2.1.1 + t.2.1.2) + (t.2.2.1 + t.2.2.2) = 12

theorem stdTriples12_card : stdTriples12.card = 1751 := by decide +kernel

section Pair
variable {A : Type*} [CommRing A] [Algebra ℚ A]

/-- Standard pair monomials of degree `d`. -/
def pairStd (x y : A) (d : ℕ) : Set A :=
  (fun p : ℕ × ℕ => x ^ p.1 * y ^ p.2) '' {p | p ∈ stdPairs ∧ p.1 + p.2 = d}

/-- Division algorithm for one pair: every monomial reduces to standard monomials of the
same degree, using only `x⁴y = 0`, `x⁵ = -6y⁵`, `y⁶ = 0`. -/
theorem pair_mem_span (x y : A) (h1 : x ^ 4 * y = 0) (h2 : x ^ 5 = -6 * y ^ 5)
    (h3 : y ^ 6 = 0) : ∀ a b : ℕ, x ^ a * y ^ b ∈ Submodule.span ℚ (pairStd x y (a + b)) := by
  intro a
  induction a using Nat.strong_induction_on with
  | _ a ih =>
  intro b
  by_cases hb : 6 ≤ b
  · have : x ^ a * y ^ b = 0 := by
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hb
      rw [pow_add, h3]; ring
    rw [this]; exact Submodule.zero_mem _
  by_cases hab : 4 ≤ a ∧ 1 ≤ b
  · have : x ^ a * y ^ b = 0 := by
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hab.1
      obtain ⟨l, rfl⟩ := Nat.exists_eq_add_of_le hab.2
      calc x ^ (4 + k) * y ^ (1 + l) = (x ^ 4 * y) * (x ^ k * y ^ l) := by ring
        _ = 0 := by rw [h1]; ring
    rw [this]; exact Submodule.zero_mem _
  by_cases ha : 5 ≤ a
  · -- then b = 0
    have hb0 : b = 0 := by omega
    subst hb0
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le ha
    have e : x ^ (5 + k) * y ^ 0 = (-6 : ℚ) • (x ^ k * y ^ 5) := by
      rw [Algebra.smul_def, map_neg, map_ofNat, pow_add, h2]; ring
    rw [e]
    have := ih k (by omega) 5
    rw [show k + 5 = 5 + k + 0 by omega] at this
    exact Submodule.smul_mem _ _ this
  · apply Submodule.subset_span
    refine ⟨(a, b), ⟨?_, rfl⟩, rfl⟩
    simp only [stdPairs, Finset.mem_filter, Finset.mem_product, Finset.mem_range]
    omega

end Pair

/-- The Jacobian (Milnor) ring of the chain sextic. -/
abbrev JacobianRing := MvPolynomial (Fin 6) ℚ ⧸ jacobianIdeal

/-- Image of `x_i` in the Jacobian ring. -/
noncomputable def xbar (i : Fin 6) : JacobianRing := Ideal.Quotient.mk jacobianIdeal (X i)

/-- The degree-12 graded piece `R₁₂` of the Jacobian ring, as a `ℚ`-subspace. -/
noncomputable def jacobianDeg12 : Submodule ℚ JacobianRing :=
  (homogeneousSubmodule (Fin 6) ℚ 12).map (Ideal.Quotient.mkₐ ℚ jacobianIdeal).toLinearMap

theorem pderiv_mem (i : Fin 6) :
    Ideal.Quotient.mk jacobianIdeal (pderiv i chainSextic) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)

theorem pair_relations (i : Fin 3) :
    xbar (Fin.castLE (by norm_num) i) ^ 4 * xbar (Fin.natAdd 3 i) = 0 ∧
    xbar (Fin.castLE (by norm_num) i) ^ 5 = -6 * xbar (Fin.natAdd 3 i) ^ 5 ∧
    xbar (Fin.natAdd 3 i) ^ 6 = 0 := by
  have hl := pderiv_mem (Fin.castLE (by norm_num) i)
  have hh := pderiv_mem (Fin.natAdd 3 i)
  rw [pderiv_chainSextic_low] at hl
  rw [pderiv_chainSextic_high] at hh
  simp only [map_mul, map_pow, map_add, map_ofNat] at hl hh
  set x := xbar (Fin.castLE (by norm_num) i)
  set y := xbar (Fin.natAdd 3 i)
  change 5 * x ^ 4 * y = 0 at hl
  change x ^ 5 + 6 * y ^ 5 = 0 at hh
  have c5 : algebraMap ℚ JacobianRing (1 / 5) * 5 = 1 := by
    rw [← map_ofNat (algebraMap ℚ JacobianRing) 5, ← map_mul]; norm_num
  have c6 : algebraMap ℚ JacobianRing (1 / 6) * 6 = 1 := by
    rw [← map_ofNat (algebraMap ℚ JacobianRing) 6, ← map_mul]; norm_num
  have e1 : x ^ 4 * y = 0 := by
    linear_combination (algebraMap ℚ JacobianRing (1 / 5)) * hl - (x ^ 4 * y) * c5
  refine ⟨e1, by linear_combination hh, ?_⟩
  linear_combination (algebraMap ℚ JacobianRing (1 / 6)) * y * hh -
    (algebraMap ℚ JacobianRing (1 / 6)) * x * e1 - y ^ 6 * c6

/-- The 1751 standard monomials of degree 12, as elements of the Jacobian ring. -/
noncomputable def stdMonomial (t : (ℕ × ℕ) × (ℕ × ℕ) × (ℕ × ℕ)) : JacobianRing :=
  (xbar 0 ^ t.1.1 * xbar 3 ^ t.1.2) * (xbar 1 ^ t.2.1.1 * xbar 4 ^ t.2.1.2) *
    (xbar 2 ^ t.2.2.1 * xbar 5 ^ t.2.2.2)

open Classical in
theorem mk_monomial_mem (d : Fin 6 →₀ ℕ) (hd : d.degree = 12) :
    Ideal.Quotient.mkₐ ℚ jacobianIdeal (monomial d 1) ∈
      Submodule.span ℚ ((stdTriples12.image stdMonomial : Finset JacobianRing) : Set JacobianRing) := by
  have hprod : Ideal.Quotient.mkₐ ℚ jacobianIdeal (monomial d 1) =
      (xbar 0 ^ d 0 * xbar 3 ^ d 3) * (xbar 1 ^ d 1 * xbar 4 ^ d 4) *
        (xbar 2 ^ d 2 * xbar 5 ^ d 5) := by
    rw [monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
    simp only [map_one, one_mul, Fin.prod_univ_six]
    simp only [xbar, Ideal.Quotient.mkₐ_eq_mk, map_mul, map_pow]
    ring
  have hsum : d 0 + d 3 + (d 1 + d 4) + (d 2 + d 5) = 12 := by
    rw [Finsupp.degree_eq_sum, Fin.sum_univ_six] at hd; omega
  obtain ⟨r0a, r0b, r0c⟩ := pair_relations 0
  obtain ⟨r1a, r1b, r1c⟩ := pair_relations 1
  obtain ⟨r2a, r2b, r2c⟩ := pair_relations 2
  have m0 := pair_mem_span _ _ r0a r0b r0c (d 0) (d 3)
  have m1 := pair_mem_span _ _ r1a r1b r1c (d 1) (d 4)
  have m2 := pair_mem_span _ _ r2a r2b r2c (d 2) (d 5)
  have hmul := Submodule.mul_mem_mul (Submodule.mul_mem_mul m0 m1) m2
  rw [Submodule.span_mul_span, Submodule.span_mul_span] at hmul
  rw [hprod]
  refine Submodule.span_mono ?_ hmul
  rintro _ ⟨_, ⟨_, ⟨p0, ⟨hp0, hd0⟩, rfl⟩, _, ⟨p1, ⟨hp1, hd1⟩, rfl⟩, rfl⟩, _, ⟨p2, ⟨hp2, hd2⟩, rfl⟩, rfl⟩
  simp only [Finset.coe_image]
  refine ⟨(p0, p1, p2), ?_, rfl⟩
  refine Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨hp0, Finset.mem_product.mpr ⟨hp1, hp2⟩⟩, ?_⟩
  dsimp only
  omega

open Classical in
/-- **Genuine upper bound** `dim_ℚ R₁₂ ≤ 1751` for the Jacobian ring of the chain sextic. -/
theorem jacobianDeg12_finrank_le : finrank ℚ jacobianDeg12 ≤ 1751 := by
  have hle : jacobianDeg12 ≤ Submodule.span ℚ
      ((stdTriples12.image stdMonomial : Finset JacobianRing) : Set JacobianRing) := by
    unfold jacobianDeg12
    rw [homogeneousSubmodule_eq_finsupp_supported, Finsupp.supported_eq_span_single,
      Submodule.map_span, Submodule.span_le]
    rintro _ ⟨_, ⟨d, hd, rfl⟩, rfl⟩
    simp only [AlgHom.toLinearMap_apply, single_eq_monomial]
    exact mk_monomial_mem d hd
  calc finrank ℚ jacobianDeg12
      ≤ finrank ℚ (Submodule.span ℚ
          ((stdTriples12.image stdMonomial : Finset JacobianRing) : Set JacobianRing)) :=
        Submodule.finrank_mono hle
    _ ≤ (stdTriples12.image stdMonomial).card := finrank_span_finset_le_card _
    _ ≤ stdTriples12.card := Finset.card_image_le
    _ = 1751 := stdTriples12_card

/-! ## Layer 1 (continued): intersection-number arithmetic -/

/-- `c₂` of `(1+h)³/(1+6h)` modulo `h³`: the degree-2 coefficient of `(1+h)³(1-6h+36h²)`. -/
noncomputable def planeSelfIntersection : ℤ :=
  (((1 : Polynomial ℤ) + Polynomial.X) ^ 3 *
    (1 - 6 * Polynomial.X + 36 * Polynomial.X ^ 2)).coeff 2

/-- `1 - 6h + 36h²` inverts `1 + 6h` modulo `h³`. -/
theorem one_add_six_mul_inverse :
    ((1 : Polynomial ℤ) + 6 * Polynomial.X) * (1 - 6 * Polynomial.X + 36 * Polynomial.X ^ 2) =
      1 + 216 * Polynomial.X ^ 3 := by ring

theorem planeSelfIntersection_eq : planeSelfIntersection = 21 := by
  have e : ((1 : Polynomial ℤ) + Polynomial.X) ^ 3 *
      (1 - 6 * Polynomial.X + 36 * Polynomial.X ^ 2) =
      1 - 3 * Polynomial.X + 21 * Polynomial.X ^ 2 + 91 * Polynomial.X ^ 3 +
        102 * Polynomial.X ^ 4 + 36 * Polynomial.X ^ 5 := by ring
  rw [planeSelfIntersection, e]
  simp [Polynomial.coeff_X, Polynomial.coeff_one, Polynomial.coeff_X_pow,
    Polynomial.coeff_ofNat_mul]

/-- Gram determinant of `(h², [Π])` with entries `6, 1, 1, 21`. -/
theorem gram_det_eq : (6 : ℚ) * 21 - 1 * 1 = 125 := by norm_num

/-! ## Layer 3: the geometric bridge (hypotheses) and the rank bounds -/

/-- The classical geometric inputs for `X = V(F)`, stated as hypotheses. Nothing here is
proved in Lean: `H` stands for `H⁴(X,ℚ)`, `H22` for `H^{2,2}(X) ⊆ H⁴(X,ℂ) = ℂ ⊗ H`,
`pairing` for the cup product, `h2` for `h²`, `P` for the class of the plane `Π`. -/
structure ChainSexticHodgeBridge (H : Type*) [AddCommGroup H] [Module ℚ H] where
  /-- `H^{2,2}(X)` inside `H⁴(X, ℂ)`. -/
  H22 : Submodule ℂ (ℂ ⊗[ℚ] H)
  /-- Griffiths residue theorem plus the Lefschetz class: `h^{2,2} = 1 + dim R₁₂`. -/
  griffiths : finrank ℂ H22 = 1 + finrank ℚ jacobianDeg12
  /-- Cup-product pairing on `H⁴(X, ℚ)`. -/
  pairing : LinearMap.BilinForm ℚ H
  /-- The class `h²`. -/
  h2 : H
  /-- The class of the plane `Π = {x3 = x4 = x5 = 0}`. -/
  P : H
  /-- `h²` is a Hodge class. -/
  h2_hodge : h2 ∈ rationalPoints H22
  /-- `[Π]` is a Hodge class (it is algebraic). -/
  P_hodge : P ∈ rationalPoints H22
  /-- `h²·h² = deg F = 6`. -/
  h2_h2 : pairing h2 h2 = 6
  /-- `h²·Π = deg Π = 1`. -/
  h2_P : pairing h2 P = 1
  /-- `Π·h² = 1`. -/
  P_h2 : pairing P h2 = 1
  /-- `Π·Π = c₂(N_{Π/X})`. -/
  P_P : pairing P P = (planeSelfIntersection : ℚ)

/-- `ρ_Hdg(X) = dim_ℚ Hdg²(X, ℚ)`: the quantity `Z` of `ContainerSeparation.Z_bounds`. -/
noncomputable def ChainSexticHodgeBridge.rho {H : Type*} [AddCommGroup H] [Module ℚ H]
    (D : ChainSexticHodgeBridge H) : ℕ :=
  finrank ℚ (rationalPoints D.H22)

/-- Upper bound from the genuine Jacobian-ring count: `ρ ≤ h^{2,2} = 1 + dim R₁₂ ≤ 1752`. -/
theorem rho_le_1752 {H : Type*} [AddCommGroup H] [Module ℚ H] [FiniteDimensional ℚ H]
    (D : ChainSexticHodgeBridge H) : D.rho ≤ 1752 := by
  have h1 := finrank_rationalPoints_le D.H22
  have h2 := jacobianDeg12_finrank_le
  unfold ChainSexticHodgeBridge.rho
  rw [D.griffiths] at h1
  omega

/-- Lower bound from the Gram determinant `6·21 − 1·1 = 125 ≠ 0` of `(h², [Π])`. -/
theorem two_le_rho {H : Type*} [AddCommGroup H] [Module ℚ H] [FiniteDimensional ℚ H]
    (D : ChainSexticHodgeBridge H) : 2 ≤ D.rho := by
  refine two_le_finrank_of_gram D.pairing D.h2 D.P D.h2_hodge D.P_hodge ?_
  rw [D.h2_h2, D.h2_P, D.P_h2, D.P_P, planeSelfIntersection_eq]
  norm_num

/-- **Main theorem.** Given the geometric bridge, `2 ≤ ρ_Hdg(V(F)) ≤ 1752`. -/
theorem rho_bounds {H : Type*} [AddCommGroup H] [Module ℚ H] [FiniteDimensional ℚ H]
    (D : ChainSexticHodgeBridge H) : 2 ≤ D.rho ∧ D.rho ≤ 1752 :=
  ⟨two_le_rho D, rho_le_1752 D⟩

end ChainSexticRank
end Hodge
