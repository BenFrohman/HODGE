/-- Nonvacuity: the actual modulus has degree 24. -/
theorem modulus_degree : modulus.degree = 24 := by
  unfold modulus
  compute_degree <;> norm_num <;> decide +kernel

/-- An actual complex root exists; the nonvanishing statements are not merely
universal statements over a field with no section roots. -/
theorem exists_complex_root : ∃ k : ℂ, aeval k modulus = 0 := by
  exact IsAlgClosed.exists_aeval_eq_zero ℂ modulus (by rw [modulus_degree]; norm_num)

/-- All eight section-coefficient formulas and the discriminant are nonzero at
an actual complex section root. This is not a geometric cycle-class assertion. -/
theorem exists_complex_nonvanishing : ∃ k : ℂ,
    k^24+66081312000*k^18-4811512860000*k^12+
      1167566400000*k^6+583200000=0 ∧
    w0 k ≠ 0 ∧ w1 k ≠ 0 ∧ w2 k ≠ 0 ∧ w3 k ≠ 0 ∧
    u0 k ≠ 0 ∧ u1 k ≠ 0 ∧ u2 k ≠ 0 ∧ u3 k ≠ 0 ∧ disc k ≠ 0 := by
  obtain ⟨k, hk⟩ := exists_complex_root
  have hm : k^24+66081312000*k^18-4811512860000*k^12+
      1167566400000*k^6+583200000=0 := by
    simpa [modulus, map_ofNat, sub_eq_add_neg] using hk
  exact ⟨k, hm, w0_ne_zero k hm, w1_ne_zero k hm, w2_ne_zero k hm,
    w3_ne_zero k hm, u0_ne_zero k hm, u1_ne_zero k hm,
    u2_ne_zero k hm, u3_ne_zero k hm, disc_ne_zero k hm⟩

end
