  apply Polynomial.funext
  intro t
  norm_num [modulus, bPoly, cPoly, dPoly, ePoly, gPoly, w0Poly, w1Poly, w2Poly, w3Poly, u0Poly, u1Poly, u2Poly, u3Poly, discPoly, u3Reduced, u3Quotient]
  <;> ring

theorem u3_bezout : u3Inverse*u3Reduced + u3Bezout*modulus = 1 := by
  apply Polynomial.funext
  intro t
  norm_num [modulus, u3Inverse, u3Reduced, u3Bezout]
  <;> ring

def discReduced : ℚ[X] := C (-2066320781/54927571956950592000 : ℚ)*X^20 + C (-151716875801405299/61030635507722880 : ℚ)*X^14 + C (921056398067765023/5085886292310240 : ℚ)*X^8 + C (-1420859056890627/28254923846168 : ℚ)*X^2

def discQuotient : ℚ[X] := C (521987749828916809/33522646234288723187761105879449600000000 : ℚ)*X^14 + C (942449053462374084530177/915919296018817573436095789056000000 : ℚ)*X^8 + C (-139162403541690318595506679/1862369235238262399320061437747200000 : ℚ)*X^2

def discInverse : ℚ[X] := C (5500004103961/159289958675156716800000 : ℚ)*X^22 + C (242298324796764759761/106193305783437811200 : ℚ)*X^16 + C (-490037553995357455007/2949814049539939200 : ℚ)*X^10 + C (651234749008574547/16387855830777440 : ℚ)*X^4

def discBezout : ℚ[X] := C (11364772775599898713541/8749410667149356752005648634536345600000000 : ℚ)*X^18 + C (20519100972489739637049780181/239054936260911386666821000943616000000 : ℚ)*X^12 + C (-1688520947467355927411154468871/270043539109548047901408908473344000000 : ℚ)*X^6 + C (1/583200000 : ℚ)

theorem disc_reduction : discPoly = discReduced + discQuotient*modulus := by
  apply Polynomial.funext
  intro t
  norm_num [modulus, bPoly, cPoly, dPoly, ePoly, gPoly, w0Poly, w1Poly, w2Poly, w3Poly, u0Poly, u1Poly, u2Poly, u3Poly, discPoly, discReduced, discQuotient]
  <;> ring

theorem disc_bezout : discInverse*discReduced + discBezout*modulus = 1 := by
  apply Polynomial.funext
  intro t
  norm_num [modulus, discInverse, discReduced, discBezout]
  <;> ring

/-- This algebra lemma is applied only to explicit polynomial identities proved above. -/
theorem eval_ne_zero_of_certificate {K : Type*} [Field K] [CharZero K] [Algebra ℚ K]
    {p r q a b : ℚ[X]} (hred : p = r+q*modulus)
    (hbez : a*r+b*modulus=1) (k : K) (hm : aeval k modulus=0) :
    aeval k p ≠ 0 := by
  intro hp
  have hh := congrArg (aeval k) hred
  have hr : aeval k r = 0 := by
    simpa [map_add, map_mul, map_one, hm, hp] using hh.symm
  have hb := congrArg (aeval k) hbez
  simp [map_add, map_mul, map_one, hm, hr] at hb

section Nonvanishing
variable {K : Type*} [Field K] [CharZero K] [Algebra ℚ K]

/-- Actual section coefficient nonvanishing: only the original modulus-root hypothesis. -/
theorem w0_ne_zero (k : K)
    (hm : k^24+66081312000*k^18-4811512860000*k^12+
      1167566400000*k^6+583200000=0) : w0 k ≠ 0 := by
  have hm' : aeval k modulus=0 := by simpa [modulus, map_ofNat, sub_eq_add_neg] using hm
  have h := eval_ne_zero_of_certificate w0_reduction w0_bezout k hm'
  simpa using h

